{
  "name": "healthcare-management-system",
  "version": "1.0.0",
  "description": "RouteClouds Health Care Management System - Full Stack Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:test": "concurrently \"cd backend && npm start\" \"cd frontend && npm run preview -- --port 3000\"",
    "start:frontend": "cd frontend && npm run preview",
    "start:backend": "cd backend && npm start",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "clean": "rm -rf frontend/node_modules backend/node_modules frontend/dist backend/dist",
    "docker:build": "./scripts/build-images.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "health-check": "./scripts/health-check.sh",
    "test": "jest",
    "test:unit": "npm run test:unit:frontend && npm run test:unit:backend",
    "test:unit:frontend": "cd frontend && npx --no-install vitest run",
    "test:unit:backend": "cd backend && npm test",
    "test:integration": "npm run test:integration:api",
    "test:integration:api": "cd backend && npm run test:integration",
    "test:e2e": "jest tests/e2e --testTimeout=30000",
    "test:e2e:chrome": "cd ../Project-Stages/Project-Stage-2-Automated-CI-CD-Pipeline && npm run test:e2e:chrome",
    "test:e2e:firefox": "cd ../Project-Stages/Project-Stage-2-Automated-CI-CD-Pipeline && npm run test:e2e:firefox",
    "test:coverage": "jest --coverage",
    "test:coverage:frontend": "cd frontend && npx --no-install vitest run --coverage",
    "test:coverage:backend": "cd backend && npm run test:coverage",
    "test:coverage-check": "npm run test:coverage:frontend && npm run test:coverage:backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:fix": "npm run lint:fix:frontend && npm run lint:fix:backend",
    "lint:fix:frontend": "cd frontend && npm run lint:fix",
    "lint:fix:backend": "cd backend && npm run lint:fix",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "cd frontend && npm run format",
    "format:backend": "cd backend && npm run format",
    "format:check": "npm run format:check:frontend && npm run format:check:backend",
    "format:check:frontend": "cd frontend && npm run format:check",
    "format:check:backend": "cd backend && npm run format:check",
    "sonar": "sonar-scanner",
    "security:scan": "npm audit && npm run security:scan:frontend && npm run security:scan:backend",
    "security:scan:frontend": "cd frontend && npm audit",
    "security:scan:backend": "cd backend && npm audit",
    "test:watch": "jest --watch"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^1.3.1",
    "babel-jest": "^30.0.5",
    "chromedriver": "^138.0.5",
    "concurrently": "^8.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jsdom": "^24.1.3",
    "selenium-webdriver": "^4.34.0",
    "vitest": "^1.3.1"
  },

  "keywords": [
    "healthcare",
    "management",
    "react",
    "nodejs",
    "postgresql",
    "docker"
  ],
  "author": "RouteClouds",
  "license": "MIT"
}
