# Healthcare Management System - Git Ignore Configuration
# This file ensures proper tracking of essential files for CI/CD pipeline

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
dist/
build/

# Environment variables (except templates)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# IMPORTANT: DO NOT IGNORE THESE FILES
# These are REQUIRED for CI/CD pipeline to work properly

# Keep package-lock.json files (CRITICAL for Docker builds)
!package-lock.json
!frontend/package-lock.json
!backend/package-lock.json

# Keep package.json files
!package.json
!frontend/package.json
!backend/package.json

# Keep setup scripts
!setup-environment.sh
!validate-setup.sh

# Keep Docker files
!Dockerfile*
!docker-compose*.yml

# Keep configuration files
!*.config.js
!*.config.ts
!tsconfig.json
!.eslintrc*
!.prettierrc*

# Keep environment templates
!.env.template
!.env.example
!.env.k8s

# Keep documentation
!README.md
!docs/
!*.md
