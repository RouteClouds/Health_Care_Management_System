# Multi-stage build for React frontend
# Stage 1: Build the React application
FROM node:18-alpine AS builder

# Build arguments for tracking
ARG BUILD_DATE
ARG COMMIT_SHA
ENV BUILD_DATE=${BUILD_DATE}
ENV COMMIT_SHA=${COMMIT_SHA}

# Build arguments for Vite environment variables
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_NAME="RouteClouds Health Platform"
ARG VITE_APP_VERSION="1.0.0"

# Set Vite environment variables for build
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_NAME=${VITE_APP_NAME}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}

# Set working directory
WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Configure npm for better network resilience
RUN npm config set registry https://registry.npmjs.org/ && \
    npm config set fetch-timeout 300000 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set fetch-retries 5

# Install dependencies with retry mechanism
# Note: Using npm install instead of npm ci for Stage-2 workspace compatibility
RUN for attempt in 1 2 3; do \
      echo "npm install attempt $attempt/3..." && \
      npm install && break || \
      (echo "npm install failed on attempt $attempt" && \
       if [ $attempt -eq 3 ]; then exit 1; fi && \
       sleep 30); \
    done

# Copy source code
COPY frontend/ .

# Build the application
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine AS production

# Build arguments for tracking
ARG BUILD_DATE
ARG COMMIT_SHA
LABEL build_date=${BUILD_DATE}
LABEL commit_sha=${COMMIT_SHA}
LABEL stage="stage-3"
LABEL component="frontend"

# Install curl for health checks
RUN apk add --no-cache curl

# Copy custom nginx configuration for frontend (CRITICAL: This contains the backend service fix)
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Copy built application from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Environment configuration will be handled by nginx.conf

# Set proper permissions (nginx user already exists)
RUN chown -R nginx:nginx /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
